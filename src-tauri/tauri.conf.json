{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yiyu",
  "version": "0.1.0",
  "identifier": "com.yiyu.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:1420/",
    "beforeBuildCommand": "pnpm build:web",
    "beforeDevCommand": "pnpm dev:web"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
